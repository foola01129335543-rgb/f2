# انسخ هذا الملف إلى .env.local واملأ القيم — لا تضع أسرارًا حقيقية في Git أبدًا
# (نفس القيم تُضبط على Vercel → Settings → Environment Variables)

# إلزاميان — من حساب Turso (turso db show <name> --url و turso db tokens create <name>)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# رابط خدمة الدمج (مشروع merger-service بعد نشره على Vercel)
MERGER_API_BASE=

# اختياري — عند ضبطه يُطلب Bearer token على /mcp
MCP_ACCESS_TOKEN=

# اختياري — تجاوز أسماء الموديلات
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=

# اختياري — سقف نافذة الانتظار داخل الطلب (افتراضي 240 ثانية)
MCP_WAIT_CAP_SECONDS=
